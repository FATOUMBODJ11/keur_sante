# Copiez ce fichier en .env.local puis adaptez.

# Secret de signature des sessions (OBLIGATOIRE en production, 32 caractères au moins)
KS_SESSION_SECRET=changez-moi-par-une-longue-valeur-aleatoire

# --- Base de données -------------------------------------------------------
# Sans DATABASE_URL : fichier local data/keur-sante.json (développement).
# En ligne : Supabase → Connect → « Transaction pooler » (port 6543), en remplaçant [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Compte de démonstration demo@keursante.sn (mettez « off » pour ne pas le créer en ligne)
# KS_DEMO_ACCOUNT=off

# --- LLM (facultatif) -------------------------------------------------------
# Sans ces variables, l'agent utilise le moteur de règles hors-ligne.
# Avec KS_LLM_PROVIDER=claude, la transcription (pseudonymisée) est envoyée à l'API Anthropic.
# KS_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# KS_LLM_MODEL=claude-opus-5-5
# KS_LLM_EFFORT=medium

# --- Wolof (en pause) ---------------------------------------------------
# L'application est en français seul. Mettez « on » pour réactiver le wolof
# (choix de langue, Kiriku-Wolof-ASR, traduction, cas en wolof).
# KS_WOLOF=on

# --- Reconnaissance vocale (facultatif) ------------------------------------
# Service fourni dans services/asr (voir README).
# ASR_FR_URL=http://localhost:8001/v1/audio/transcriptions
# ASR_FR_MODEL=whisper-small
# ASR_WO_URL=http://localhost:8001/v1/audio/transcriptions/wolof
# Modèle wolof affiché dans l'app (le service ASR lit la même variable)
# KIRIKU_MODEL_ID=AIHubSN/Kiriku-Wolof-ASR
# ASR_API_KEY=

# Dossier de données (défaut : ./data)
# KS_DATA_DIR=./data
