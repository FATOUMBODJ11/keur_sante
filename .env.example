# Copiez ce fichier en .env.local puis adaptez.

# Secret de signature des sessions (OBLIGATOIRE en production, 32 caractères au moins)
KS_SESSION_SECRET=changez-moi-par-une-longue-valeur-aleatoire

# --- Base de données -------------------------------------------------------
# Sans DATABASE_URL : fichier local data/keur-sante.json (développement).
# En ligne : Supabase → Connect → « Transaction pooler » (port 6543), en remplaçant [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Compte de démonstration demo@keursante.sn (mettez « off » pour ne pas le créer en ligne)
# KS_DEMO_ACCOUNT=off

# --- Comptes ----------------------------------------------------------------
# Administrateurs de la plateforme (page Administration), séparés par des virgules
# KS_ADMIN_EMAILS=vous@exemple.sn
# Envoi des e-mails de réinitialisation du mot de passe (resend.com) ; sans clé, l'admin génère le lien
# RESEND_API_KEY=re_...
# KS_MAIL_FROM=Keur Santé <no-reply@votre-domaine.sn>

# --- LLM (facultatif) -------------------------------------------------------
# Claude est activé dès que ANTHROPIC_API_KEY est défini (KS_LLM_PROVIDER=rules pour forcer les règles).
# La transcription (pseudonymisée) est alors envoyée à l'API Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# KS_LLM_MODEL=claude-opus-5-5
# KS_LLM_EFFORT=medium

# --- Reconnaissance vocale ElevenLabs Scribe (recommandé) -------------------
# Active le wolof et la séparation des voix ; le micro passe par Scribe (français et wolof).
# ELEVENLABS_API_KEY=...
# ELEVENLABS_STT_MODEL=scribe_v2
# Garder la dictée du navigateur pour le français :
# KS_ASR_FR=browser

# --- Wolof -----------------------------------------------------------------
# Actif dès que ELEVENLABS_API_KEY est défini. « off » le remet en pause,
# « on » l'active sans reconnaissance vocale (saisie seulement).
# KS_WOLOF=off

# --- Reconnaissance vocale auto-hébergée (facultatif) ----------------------
# Service fourni dans services/asr (voir README).
# ASR_FR_URL=http://localhost:8001/v1/audio/transcriptions
# ASR_FR_MODEL=whisper-small
# ASR_WO_URL=http://localhost:8001/v1/audio/transcriptions/wolof
# Modèle wolof affiché dans l'app (le service ASR lit la même variable)
# KIRIKU_MODEL_ID=AIHubSN/Kiriku-Wolof-ASR
# ASR_API_KEY=

# Dossier de données (défaut : ./data)
# KS_DATA_DIR=./data
